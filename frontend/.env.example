# Copy to .env.production to control the production build. Not needed for `vite dev`.

# Stripe is running in sandbox/test mode, so anyone could "upgrade" to Pro for
# free using a published Stripe test card. Keep this false on any public
# deployment; the checkout button stays hidden and the backend also rejects
# the request as a second layer of defense (see backend/billing.py).
VITE_ENABLE_BILLING=false
