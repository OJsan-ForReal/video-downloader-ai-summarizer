# Copy this file to .env and fill in real values. Nothing here is a real secret.

# --- Auth (required) ---
# Any long random string; used to sign JWTs and password-reset/verification tokens.
AUTH_SECRET=change-me-to-a-long-random-string

# Google OAuth2 (optional). Leave blank and email+password login still works;
# only the "Sign in with Google" button will error until these are set.
# Get these from Google Cloud Console -> APIs & Services -> Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where the frontend is served from. Used to build links in verification emails
# and as the redirect target after Google OAuth / Stripe checkout.
FRONTEND_URL=http://localhost:5173

# --- AI summarization (required for the summarize/chat features) ---
# OpenRouter is the primary LLM provider (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Groq is used as a Whisper fallback for videos with no subtitles
# (https://console.groq.com/keys).
GROQ_API_KEY=

# --- Stripe billing (optional, sandbox/test mode recommended) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Printed by `stripe listen` when forwarding webhooks to your local server.
STRIPE_WEBHOOK_SECRET=
# Master switch for the checkout endpoint. Set to false on any public deployment
# while Stripe is still in test mode (anyone could grab a free Pro plan with a
# published test card number).
BILLING_ENABLED=true

# --- Transactional email via Brevo (optional) ---
# https://app.brevo.com/settings/keys/api
# If left blank, verification emails are skipped (a line is printed to the
# server log instead) so local development doesn't require an email provider.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Video Downloader

# --- Privacy-conscious visit analytics (optional) ---
# Any random string. Used to salt the IP hash stored for the visit counter
# (raw IPs are never persisted). Leave blank to disable the analytics feature
# entirely without affecting anything else.
VISIT_SALT=

# --- Residential proxy workaround (optional) ---
# YouTube/Bilibili rate-limit or block requests coming from datacenter IPs
# (e.g. most cloud VM providers). If set, only requests to those two hosts are
# routed through this proxy; everything else connects directly. See the README
# for how this was solved with a spare Android phone + a reverse SSH tunnel.
YT_DLP_PROXY=
